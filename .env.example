# Copy this file to `.env` and fill in the values.
# `.env` is git-ignored. Never commit a real bot token.

# Discord bot token from https://discord.com/developers/applications -> Bot -> Reset Token.
# Optional if you prefer entering the token in Settings (it is then stored in your
# OS credential store: Windows Credential Manager, macOS Keychain or Secret Service).
DISCORD_BOT_TOKEN=

# IDs of the servers (guilds) to monitor, separated by commas. Members of each
# server are fetched and shown separately. Enable Developer Mode in Discord, then
# right-click a server icon -> "Copy Server ID". Or run: python set_guild_id.py
# The bot must be invited to every server (OAuth2 scope "bot").
# Example value: 123456789012345678,987654321098765432
DISCORD_GUILD_IDS=

# Optional: override where the SQLite database, logs and avatar cache are stored.
# Defaults to ./data next to main.py.
# SCOUT_DATA_DIR=
